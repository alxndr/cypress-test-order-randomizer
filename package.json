{
  "name": "cypress-test-order-randomizer",
  "version": "1.0.0",
  "description": "Cypress plugin which randomizes the order in which tests are run",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.build.cjs.json && node --input-type=commonjs -e 'require(`node:fs`).writeFileSync(`dist/cjs/package.json`, JSON.stringify({type:`commonjs`}))'",
    "postbuild": "echo '\\nBuild succeeded!'",
    "prelint": "echo '\\nLinting...'",
    "lint": "oxlint src/ test/",
    "postlint": "echo '\\nLinting succeeded!'",
    "pretest": "echo '\\nTesting...'",
    "test": "npm run test:unit && npm run test:e2e",
    "posttest": "echo '\\nTesting succeeded!'",
    "test:e2e": "npm run build && node test/e2e.mjs",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "pretypecheck": "echo '\\nTypechecking...'",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json --noEmit",
    "posttypecheck": "echo '\\nTypechecking succeeded!'",
    "validate": "npm run lint && npm run typecheck && npm run test",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run build && npm pack --dry-run"
  },
  "keywords": [
    "cypress",
    "plugin",
    "randomize",
    "test-order",
    "shuffle",
    "ast"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alxndr/cypress-test-order-randomizer.git"
  },
  "author": "@alxndr",
  "contributors": ["@alxndr", "Claude Code"],
  "bugs": "https://github.com/alxndr/cypress-test-order-randomizer/issues",
  "homepage": "https://github.com/alxndr/cypress-test-order-randomizer#readme",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "cypress": ">=15.0.0",
    "esbuild": ">=0.17.0"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    }
  },
  "dependencies": {
    "@babel/generator": "^7.29.7",
    "@babel/parser": "^7.29.7",
    "fast-glob": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "cypress": "^15.16.0",
    "esbuild": "^0.28.0",
    "oxlint": "^1.68.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.8"
  },
  "type": "module",
  "files": ["dist", "README.md", "LICENSE"],
  "main": "dist/cjs/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/index.d.ts"
    }
  }
}
