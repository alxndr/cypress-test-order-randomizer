{
  "name": "cypress-test-order-randomizer",
  "version": "0.1.0-alpha",
  "description": "WIP — Cypress v15 plugin that randomizes the order in which tests are run (in a reproducible way, and using AST manipulation)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "oxlint src/ test/",
    "test": "npm run test:unit && npm run test:e2e",
    "test:e2e": "npm run build && node test/e2e.mjs",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json --noEmit"
  },
  "keywords": [
    "cypress",
    "plugin",
    "randomize",
    "test-order",
    "shuffle",
    "ast"
  ],
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.10.0"
  },
  "peerDependencies": {
    "cypress": ">=15.0.0",
    "esbuild": ">=0.17.0"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    }
  },
  "dependencies": {
    "@babel/generator": "^7.23.0",
    "@babel/parser": "^7.23.0",
    "fast-glob": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "cypress": "^15.14.1",
    "esbuild": "^0.23.0",
    "oxlint": "^1.61.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
